{
  "_doc": "Fontes do material do projeto para `coala.py sync`. rules: mode markdown|text|whole|pdf · type episodic|semantic|procedural · origin owner|agent|untrusted|system · tags aceitam {stem} {name} {dir} {rule}; a primeira regra que apanha um ficheiro ganha. code: o catálogo de código (símbolos por ficheiro) é automático — `include`/`exclude` são globs, `enabled: false` desliga. Ver references/instalar.md da coala-agent-skill.",
  "version": 2,
  "key_prefix": "proj",
  "path_prefix": "",
  "exclude": [],
  "rules": [
    {
      "name": "readme",
      "include": [
        "README.md"
      ],
      "mode": "markdown",
      "type": "semantic",
      "origin": "agent",
      "tags": "docs,readme"
    },
    {
      "name": "raiz",
      "include": [
        "CHANGELOG.md",
        "CONTRIBUTING.md",
        "SKILL.md"
      ],
      "mode": "markdown",
      "type": "semantic",
      "origin": "agent",
      "tags": "docs,{stem}"
    },
    {
      "name": "estudo-interno",
      "include": [
        "pesquisas/2026-11-04-estudo-tecnico-guardrails-anatomia-bypass-defesa.md"
      ],
      "mode": "markdown",
      "type": "semantic",
      "origin": "untrusted",
      "tags": "pesquisa,estudo-fornecido,errata,{stem}"
    },
    {
      "name": "avaliacao-documental-jev",
      "include": [
        "references/avaliacao-prompt-builder-jev.md"
      ],
      "mode": "markdown",
      "type": "procedural",
      "origin": "agent",
      "tags": "docs,avaliacao,prompt-builder,jev,somente-markdown,nao-executar"
    },
    {
      "name": "evidencias-externas",
      "include": [
        "references/evidencias.json"
      ],
      "mode": "text",
      "type": "semantic",
      "origin": "untrusted",
      "tags": "evidencias,errata,metricas,contexto"
    },
    {
      "name": "referencias",
      "include": [
        "references/*.md"
      ],
      "mode": "markdown",
      "type": "semantic",
      "origin": "untrusted",
      "tags": "docs,references,sintese-com-evidencia-externa,{stem}"
    },
    {
      "name": "pesquisas",
      "include": [
        "pesquisas/*.md"
      ],
      "mode": "markdown",
      "type": "semantic",
      "origin": "untrusted",
      "tags": "pesquisa,dossie,historico,{stem}"
    }
  ],
  "code": {
    "enabled": true,
    "include": [],
    "exclude": []
  },
  "graph": {
    "entities": [],
    "edges": []
  }
}
